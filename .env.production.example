# Copy to .env on the EC2 server (do not commit real passwords).
NODE_ENV=production
HOST=0.0.0.0
PORT=5373
POSTGRES_USER=yoga
POSTGRES_PASSWORD=yoga
POSTGRES_DB=yoga_db
DATABASE_URL=postgresql://yoga:yoga@database:5373/yoga_db
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
CLIENT_ORIGIN=https://yogawithmasterankur.com,https://www.yogawithmasterankur.com
ADMIN_EMAIL=admin@yogawithmasterankur.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
DOCKERHUB_USER=yourdockerhubuser
BACKEND_PORT=8080
# --- Host port mappings (the host side of host:container) ---
# Change these if a port is already taken on your machine.
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=8080

