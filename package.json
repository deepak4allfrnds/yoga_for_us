{
  "name": "yoga-for-us",
  "private": true,
  "description": "3-tier monorepo: frontend (React), backend (Express), database (PostgreSQL)",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c green,cyan \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:database": "docker compose -f docker-compose.dev.yml up -d database",
    "install:all": "npm --prefix frontend install && npm --prefix backend install",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:build": "docker compose -f docker-compose.prod.yml build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
